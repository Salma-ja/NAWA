# Copy this file to  web/.env  and fill in your key, then restart the server.
# web/.env is git-ignored on purpose -- never commit a real key.

# Required. Get one from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional. Any chat-completions model your account can access.
OPENAI_MODEL=gpt-4o-mini

# Optional. Only change this for Azure OpenAI or a compatible proxy.
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional. Defaults to 4174.
# PORT=4174
